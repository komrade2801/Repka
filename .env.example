# Backend (root or backend/.env — Settings reads both)
DATABASE_URL=sqlite:///./repka.db
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
# CSV locally OK with validator; on Render/pydantic-settings use JSON array:
# CORS_ORIGINS=["https://<your-app>.vercel.app","http://localhost:5173","http://127.0.0.1:5173"]
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vercel / local Vite — set in hosting env or frontend/.env)
# VITE_API_URL=https://<your-service>.onrender.com
# VITE_API_URL=http://127.0.0.1:8000